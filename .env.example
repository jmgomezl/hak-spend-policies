# Needed only for `npm run test:integration`, which runs against Hedera testnet with a funded
# account acting as the agent. Unit tests need none of this.
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
# 0x-prefixed hex ECDSA key (portal default), raw hex, or DER
HEDERA_PRIVATE_KEY=
# Only for raw 64-char hex keys: ecdsa (default) or ed25519
HEDERA_KEY_TYPE=

# Needed only for `npm run approve`, run by the owner, never by the agent
OWNER_ACCOUNT_ID=0.0.xxxxxxx
OWNER_PRIVATE_KEY=
OWNER_KEY_TYPE=
